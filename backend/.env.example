APP_NAME=KeeperKit Rules
APP_ENV=development

RAW_DOCS_DIR=./data/raw
PROCESSED_DOCS_DIR=./data/processed
INDEX_DIR=./data/index

RETRIEVAL_TOP_K=8
RERANK_TOP_K=3
RERANKER_PROVIDER=simple
# RERANKER_PROVIDER=bge
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-256
# EMBEDDING_PROVIDER=sentence_transformers
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
VECTOR_STORE_PROVIDER=json
# VECTOR_STORE_PROVIDER=chroma
CHROMA_COLLECTION=keeperkit_rules

GENERATOR_PROVIDER=template
# GENERATOR_PROVIDER=llm
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-me
# DEEPSEEK_API_KEY=replace-me
LLM_MODEL=deepseek-chat
